# Copie para .env e ajuste conforme o seu ambiente.
# Credenciais padrão do docker-compose.yml deste projeto:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cursosdb?schema=public"

# Chave que assina os tokens JWT. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Origem liberada no CORS (frontend Vite)
FRONTEND_URL="http://localhost:5173"
